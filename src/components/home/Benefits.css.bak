.benefits-section {
  background: #0c0e0f;
  border-top: 1px solid rgba(255, 255, 255, 0.05);
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  padding: 28px 0;
}

.benefits-container {
  width: min(1480px, calc(100% - 70px));
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
}

.benefit-item {
  min-height: 78px;
  padding: 0 30px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  border-right: 1px solid rgba(255, 255, 255, 0.07);
}

.benefit-item:first-child {
  padding-left: 0;
}

.benefit-item:last-child {
  border-right: 0;
  padding-right: 0;
}

.benefit-icon {
  width: 48px;
  height: 48px;
  flex-shrink: 0;
  border-radius: 50%;
  border: 1px solid rgba(255, 42, 163, 0.45);
  background: rgba(255, 42, 163, 0.06);
  display: grid;
  place-items: center;
  color: var(--pink);
  font-size: 1.25rem;
  box-shadow: 0 0 16px rgba(255, 42, 163, 0.08);
}

.benefit-item h3 {
  margin: 0 0 5px;
  font-size: 0.76rem;
  font-weight: 900;
  letter-spacing: 0.08em;
}

.benefit-item p {
  margin: 0;
  color: #888;
  font-size: 0.72rem;
}

@media (max-width: 900px) {
  .benefits-container {
    grid-template-columns: repeat(2, 1fr);
    gap: 22px 0;
  }

  .benefit-item:nth-child(2) {
    border-right: 0;
  }
}

@media (max-width: 550px) {
  .benefits-container {
    width: calc(100% - 28px);
    grid-template-columns: 1fr;
  }

  .benefit-item {
    justify-content: flex-start;
    border-right: 0;
    padding: 8px 0;
  }
}
